{
  "name": "gautam-cli",
  "version": "0.2.0",
  "description": "Explore Gautam Vhavle's projects, experience, and live GitHub activity from your terminal.",
  "type": "module",
  "bin": {
    "gautam": "index.js"
  },
  "files": [
    "index.js",
    "data.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js",
    "check": "node --check index.js && node --check data.js",
    "smoke": "node -e \"const { spawnSync } = require('node:child_process'); const result = spawnSync(process.execPath, ['index.js', '--json'], { encoding: 'utf8' }); JSON.parse(result.stdout); if (result.status) process.exit(result.status);\"",
    "test": "npm run check && npm run smoke && node index.js --help && node index.js --version",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cli",
    "portfolio",
    "gautam-vhavle",
    "developer",
    "interactive",
    "genai",
    "iot",
    "terminal",
    "developer-portfolio",
    "open-source",
    "github-api"
  ],
  "author": {
    "name": "Gautam Vhavle",
    "email": "gautamvhavle@gmail.com",
    "url": "https://gautamvhavle.vercel.app"
  },
  "contributors": [
    {
      "name": "Gautam Vhavle",
      "url": "https://github.com/GautamVhavle"
    }
  ],
  "license": "MIT",
  "homepage": "https://gautamvhavle.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GautamVhavle/gautam-cli.git"
  },
  "bugs": {
    "url": "https://github.com/GautamVhavle/gautam-cli/issues"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "gradient-string": "^3.0.0",
    "open": "^10.1.0"
  }
}
